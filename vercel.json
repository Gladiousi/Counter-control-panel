{
  "rewrites": [
    {
      "source": "/c300/api/:path*",
      "destination": "http://showroom.eis24.me/c300/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/c300/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}